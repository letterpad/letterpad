{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": [
    "apps/admin/src/graphql/schema/**/*.graphqls",
    "apps/**/*.graphql",
    "packages/config/fonts/*.woff2",
    "packages/config/postcss.config.js",
    "packages/config/tailwind.config.js"
  ],
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "NEXT_PUBLIC_*",
        "NEXTAUTH_URL",
        "ROOT_URL",
        "SECRET_KEY",
        "STRIPE_SECRET_KEY"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/~partytown/**"
      ]
    },
    "letterpad-graphql#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "graphql.schema.json",
        "src/graphql.ts",
        "src/hooks.ts"
      ]
    },
    "lint": {
      "outputs": []
    },
    "prepare": {
      "dependsOn": [
        "letterpad-graphql#build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [
        "letterpad-sdk#build",
        "letterpad-graphql#build"
      ],
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "outputs": [
        "node_modules/.prisma/client"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "admin/**/*.tsx",
        "admin/**/*.ts",
        "client/**/*.ts",
        "client/**/*.tsx"
      ]
    },
    "e2e:ci": {
      "outputs": [],
      "inputs": [
        "admin/**/*.tsx",
        "admin/**/*.ts",
        "client/**/*.ts",
        "client/**/*.tsx"
      ]
    },
    "e2e": {
      "outputs": []
    },
    "codegen": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "lint:fix": {
      "outputs": []
    },
    "start": {
      "outputs": []
    },
    "find-deadcode": {
      "outputs": []
    },
    "seed": {
      "outputs": [
        "dist/**"
      ]
    }
  }
}
